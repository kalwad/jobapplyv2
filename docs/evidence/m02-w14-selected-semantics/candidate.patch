+/** Actual selected-option ambiguity after a verified transaction. */
+import { test, expect } from "./support/extension-test.ts";
+import { installW14NativeWitness } from "./support/autofill-w14-native-witness.ts";
+import {
+  openHarness,
+  setFixture,
