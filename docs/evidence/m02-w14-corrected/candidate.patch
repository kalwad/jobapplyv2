+++ b/e2e/extension/extension-w14-validation.spec.ts
@@ -0,0 +1,112 @@
+import { test, expect } from "./support/extension-test.ts";
+import { openHarness } from "./support/research-harness.ts";
+import { RESEARCH_MATRIX } from "../../packages/ats-adapters/research/matrix.ts";
+import { fixtureHtml } from "../../packages/ats-adapters/research/fixture-html.ts";
+import { executeMv3Autofill } from "./support/autofill-benchmark.ts";
+import {
+  installW14SiteRuntime,
+  type W14SanitizedInput,
+} from "./support/autofill-w14.ts";
+
+const source = RESEARCH_MATRIX.find(
+  (v) =>
+    v.expected.validation === "REQUIRED_MISSING" && !v.expected.sessionBoundary,
+);
+if (source === undefined) throw new Error("W14_VALIDATION_RECIPE_ABSENT");
+const html = fixtureHtml(source);
+const scenarios = [
+  {
+    name: "native-valid email clears the recoverable site error and survives controlled replacement",
+    email: "synthetic@example.invalid",
+    mode: "RECOVERABLE_NATIVE_REQUIRED_V1",
+    expected: "FILLED",
+    restoreRejection: false,
+  },
+  {
+    name: "malformed email retains native and ARIA rejection",
+    email: "invalid-email",
+    mode: "RECOVERABLE_NATIVE_REQUIRED_V1",
+    expected: "UNRESOLVED",
+    restoreRejection: false,
+  },
+  {
+    name: "persistent site rejection remains rejected despite native validity",
+    email: "synthetic@example.invalid",
+    mode: "STATIC_REJECTION_V1",
+    expected: "UNRESOLVED",
+    restoreRejection: false,
+  },
+  {
+    name: "a rerender restoring rejection prevents a verified-fill claim",
+    email: "synthetic@example.invalid",
+    mode: "RECOVERABLE_NATIVE_REQUIRED_V1",
+    expected: "UNRESOLVED",
+    restoreRejection: true,
+  },
+] as const;
+
+for (const scenario of scenarios) {
+  test(`W14 site runtime: ${scenario.name}`, async ({
+    extensionContext,
+    extensionId,
+    serviceWorker,
+  }) => {
+    const harness = await openHarness(
+      extensionContext,
+      extensionId,
+      serviceWorker,
+      "/native/",
+    );
+    try {
+      const input: W14SanitizedInput = {
+        html,
+        site_runtime: scenario.mode,
+        profile: [{ concept: "EMAIL_ADDRESS", value: scenario.email }],
+      };
+      const observed = await executeMv3Autofill(harness, input, async () => {
+        await installW14SiteRuntime(harness, input.site_runtime);
+        if (scenario.restoreRejection)
+          await harness.page.evaluate(() => {
+            document.addEventListener(
+              "input",
+              (event) => {
+                const node = event.target;
+                if (node instanceof HTMLInputElement && node.type === "email")
+                  setTimeout(() => {
+                    node.setAttribute("aria-invalid", "true");
+                  }, 10);
+              },
+              true,
+            );
+          });
+      });
+      expect(
+        observed.fields.find((field) => field.key === "email")?.status,
+      ).toBe(scenario.expected);
+      expect(observed.meter.actions).toHaveLength(1);
+      expect(observed.meter.rerenders).toBe(1);
+      expect(observed.meter.navigation).toBe(0);
+      expect(observed.meter.submission).toBe(0);
+      if (scenario.expected === "UNRESOLVED") {
+        expect(
+          observed.fields.find((field) => field.key === "email")?.reason,
+        ).toBe("REQUIRED_UNRESOLVED");
+        expect(
+          observed.reconciliation.inventory.counts.required_unresolved,
+        ).toBeGreaterThan(0);
+        expect(observed.reconciliation.inventory.readiness).toBe("NOT_READY");
+      } else {
+        expect(
+          observed.fields.find((field) => field.key === "email")?.persistence,
+        ).toBe("PERSISTED");
+        expect(
+          observed.fields.find((field) => field.key === "email")
+            ?.site_acceptance,
+        ).toBe("ACCEPTED");
+      }
+    } finally {
+      await harness.page.close();
+      await harness.controller.close();
+    }
+  });
+}
diff --git a/e2e/extension/support/autofill-w14.ts b/e2e/extension/support/autofill-w14.ts
new file mode 100644
index 0000000..e81d62a
--- /dev/null
+++ b/e2e/extension/support/autofill-w14.ts
@@ -0,0 +1,430 @@
+/** W14 visible development measurement. No gate or private-holdout authority. */
+import { semanticDigest } from "../../../apps/extension/src/semantic-identity.ts";
+import { normalizeText } from "../../../apps/extension/src/field-scanner.ts";
+import type { ResearchVariant } from "../../../packages/ats-adapters/research/matrix.ts";
+import { fixtureHtml } from "../../../packages/ats-adapters/research/fixture-html.ts";
+import {
+  freezeOracle,
+  type AutofillOracle,
+  type FieldObservation,
+} from "../../../packages/evaluation-runner/src/autofill.ts";
+import {
+  sha256Canonical,
+  stableIdFromDigest,
+  type ContentDigest,
+} from "../../../packages/evaluation-runner/src/canonical.ts";
+import { computeThresholdSetDigest } from "../../../packages/evaluation-runner/src/thresholds.ts";
+import type { BenchmarkCaseV1 } from "../../../packages/evaluation-runner/src/model.ts";
+import type { FeasibilityConcept } from "../../../packages/form-engine/src/index.ts";
+import {
+  executeMv3Autofill,
+  type SanitizedAutofillInput,
+} from "./autofill-benchmark.ts";
+import type { Harness } from "./research-harness.ts";
+
+export const W14_SITE_RUNTIME_VERSION = "1.0.0";
+export type W14SanitizedInput = SanitizedAutofillInput & {
+  site_runtime: "RECOVERABLE_NATIVE_REQUIRED_V1" | "STATIC_REJECTION_V1";
+};
+
+/** Site-owned validation behavior. It has no oracle/profile/expected-value input. */
+export async function installW14SiteRuntime(
+  harness: Harness,
+  mode: W14SanitizedInput["site_runtime"],
+) {
+  await harness.page.evaluate((runtimeMode) => {
+    if (runtimeMode !== "RECOVERABLE_NATIVE_REQUIRED_V1") return;
+    const validate = (event: Event) => {
+      const node = event.target;
+      if (!(node instanceof HTMLInputElement) || node.type !== "email") return;
+      const error = document.getElementById("email-error");
+      if (
+        error?.textContent !== "Email address is required." ||
+        !node
+          .getAttribute("aria-describedby")
+          ?.split(/\s+/u)
+          .includes("email-error")
+      )
+        return;
+      node.setAttribute("aria-invalid", String(!node.validity.valid));
+      error.hidden = node.validity.valid;
+    };
+    document.addEventListener("input", validate, true);
+    document.addEventListener("change", validate, true);
+  }, mode);
+}
+
+// This cohort is declared before execution. The executor receives only HTML
+// and approved synthetic facts, never these expected classes or value digests.
+export const W14_CONTACT_COHORT: Readonly<Record<string, FeasibilityConcept>> =
+  {
+    "first-name": "FIRST_NAME",
+    "last-name": "LAST_NAME",
+    email: "EMAIL_ADDRESS",
+    phone: "PHONE_NUMBER",
+    website: "WEBSITE_URL",
+    "street-address": "ADDRESS_LINE_1",
+    city: "ADDRESS_CITY",
+    state: "ADDRESS_REGION",
+    province: "ADDRESS_REGION",
+    county: "ADDRESS_REGION",
+    "postal-code": "ADDRESS_POSTAL_CODE",
+    country: "ADDRESS_COUNTRY",
+  };
+
+/** Independently declared locale examples, not values inferred from options. */
+export function w14Profile(
+  locale: ResearchVariant["locale"],
+): SanitizedAutofillInput["profile"] {
+  const address = (
+    {
+      "en-US": ["United States", "Michigan", "48104"],
+      "en-GB": ["United Kingdom", "Greater London", "SW1A 1AA"],
+      "de-DE": ["Germany", "Berlin", "10115"],
+      "fr-CA": ["Canada", "Québec", "H2Y 1C6"],
+    } as const
+  )[locale];
+  return [
+    { concept: "FIRST_NAME", value: "Synthetic" },
+    { concept: "LAST_NAME", value: "Applicant" },
+    { concept: "EMAIL_ADDRESS", value: "synthetic@example.invalid" },
+    { concept: "PHONE_NUMBER", value: "2025550100" },
+    { concept: "WEBSITE_URL", value: "https://example.invalid/profile" },
+    { concept: "ADDRESS_LINE_1", value: "100 Synthetic Avenue" },
+    { concept: "ADDRESS_CITY", value: "Synthetic City" },
+    { concept: "ADDRESS_REGION", value: address[1], valueToken: address[1] },
+    { concept: "ADDRESS_POSTAL_CODE", value: address[2] },
+    { concept: "ADDRESS_COUNTRY", value: address[0], valueToken: address[0] },
+  ];
+}
+
+export function w14Recipe(
+  variant: ResearchVariant,
+  matrixDigest: ContentDigest,
+  corpus: { version: string; digest: ContentDigest },
+  toolchainDigest: ContentDigest,
+) {
+  const input: W14SanitizedInput = {
+    site_runtime:
+      variant.expected.validation === "REQUIRED_MISSING"
+        ? "RECOVERABLE_NATIVE_REQUIRED_V1"
+        : "STATIC_REJECTION_V1",
+    html: fixtureHtml(variant),
+    profile: w14Profile(variant.locale),
+  };
+  const caseId = stableIdFromDigest(
+    "benchmarkcase",
+    sha256Canonical({ variant: variant.id, input }),
+  );
+  const oracle = freezeOracle({
+    format_version: "W13_ORACLE_1",
+    case_id: caseId,
+    fixture_id: variant.id,
+    matrix_version: "1.0.0",
+    matrix_digest: matrixDigest,
+    corpus_version: corpus.version,
+    corpus_digest: corpus.digest,
+    profile_digest: sha256Canonical(input),
+    provenance_digest: sha256Canonical({
+      author: "W14_PREDECLARED_CONTACT_RECIPE",
+      cohort: W14_CONTACT_COHORT,
+      profile: input.profile,
+      variant,
+    }),
+    fields: variant.controls.map((control) => {
+      const concept = W14_CONTACT_COHORT[control.id];
+      const fact = input.profile.find((f) => f.concept === concept);
+      const sensitive = control.policy === "SENSITIVE_ABSTAIN";
+      const honeypot = control.policy === "HONEYPOT_ABSTAIN";
+      const supported = !sensitive && !honeypot && fact !== undefined;
+      const fill = supported && !variant.expected.sessionBoundary;
+      return {
+        key: control.id,
+        concept: concept ?? "UNKNOWN",
+        required: control.required,
+        visible: !honeypot,
+        enabled: !variant.expected.sessionBoundary,
+        class: sensitive
+          ? "SENSITIVE"
+          : honeypot
+            ? "HONEYPOT"
+            : supported
+              ? "ORDINARY"
+              : "UNSUPPORTED",
+        supported,
+        expected: fill ? "FILL" : "ABSTAIN",
+        value_digest: fill ? sha256Canonical(fact.value) : null,
+        option: control.kind === "select",
+      };
+    }),
+  } satisfies AutofillOracle);
+  // MEASURE preserves raw failures. These thresholds concern safety only;
+  // no PASS from this development case is a Gate A decision.
+  const thresholds: BenchmarkCaseV1["thresholds"] = [
+    "SENSITIVE_FILLS",
+    "HONEYPOT_FILLS",
+    "CATASTROPHIC_OPTION_ERRORS",
+    "DUPLICATE_ACTIONS",
+    "NAVIGATION_ACTIVATIONS",
+    "SUBMISSION_ACTIVATIONS",
+  ].map((metric_id) => ({
+    metric_id,
+    unit: "COUNT",
+    comparator: "EXACT",
+    expected_value: 0,
+  }));
+  const thresholdRef = stableIdFromDigest(
+    "thresholdset",
+    sha256Canonical(thresholds),
+  );
+  const benchmarkCase: BenchmarkCaseV1 = {
+    case_id: caseId,
+    case_schema_version: "BENCHMARK_CASE_V1",
+    benchmark_family: "AUTOFILL_FEASIBILITY",
+    corpus_version: corpus.version,
+    corpus_digest: corpus.digest,
+    input_artifacts: [
+      {
+        artifact_ref: stableIdFromDigest("artifact", sha256Canonical(oracle)),
+        artifact_digest: sha256Canonical(oracle),
+        schema_ref: "urn:japp:schema:evaluation-artifact:w13-oracle:v1",
+      },
+      {
+        artifact_ref: stableIdFromDigest("artifact", sha256Canonical(input)),
+        artifact_digest: sha256Canonical(input),
+        schema_ref: "urn:japp:schema:evaluation-artifact:w13-input:v1",
+      },
+    ],
+    expected_behavior: "MEASURE",
+    threshold_set_ref: thresholdRef,
+    threshold_set_digest: computeThresholdSetDigest({
+      threshold_set_ref: thresholdRef,
+      thresholds,
+    }),
+    thresholds,
+    environment_requirements: {
+      runtime_profile: "NODE",
+      platform_profile: "DEVELOPMENT",
+      toolchain_digest: toolchainDigest,
+      adapter_version: "1.0.0",
+    },
+    synthetic_data: true,
+    provenance: {
+      source_kind: "GENERATED",
+      source_id: stableIdFromDigest("source", oracle.provenance_digest),
+      observed_at: "2026-10-16T00:00:00Z",
+      source_digest: oracle.provenance_digest,
+    },
+    holdout_visibility: "PUBLIC_SYNTHETIC",
+    applicable_platform_profiles: ["DEVELOPMENT"],
+  };
+  return { benchmarkCase, oracle, input };
+}
+
+export async function logicalControls(
+  harness: Pick<Harness, "page">,
+  markup?: string,
+) {
+  const controls = await harness.page.evaluate((html) => {
+    const root =
+      html === null
+        ? document
+        : new DOMParser().parseFromString(html, "text/html");
+    const seen = new Set<string>();
+    return [
+      ...root.querySelectorAll<
+        HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement
+      >("input,select,textarea"),
+    ].flatMap((node) => {
+      const radio = node instanceof HTMLInputElement && node.type === "radio";
+      const group = radio ? node.closest("fieldset") : null;
+      const key = group?.id ?? node.id;
+      if (seen.has(key)) return [];
+      seen.add(key);
+      const members =
+        group === null
+          ? [node]
+          : [...group.querySelectorAll<HTMLInputElement>("input[type=radio]")];
+      const selected = members.find(
+        (member) => member instanceof HTMLInputElement && member.checked,
+      );
+      const value = radio
+        ? (selected?.value ?? "")
+        : node instanceof HTMLInputElement && node.type === "checkbox"
+          ? node.checked
+            ? "true"
+            : ""
+          : node.value;
+      const scannerKind = radio
+        ? "RADIO_GROUP"
+        : node.getAttribute("role") === "combobox"
+          ? "COMBOBOX"
+          : node instanceof HTMLTextAreaElement
+            ? "TEXTAREA"
+            : node instanceof HTMLSelectElement
+              ? node.multiple
+                ? "MULTI_SELECT"
+                : "SELECT"
+              : node.type === "date"
+                ? "DATE"
+                : node.type === "file"
+                  ? "FILE"
+                  : node.type === "checkbox"
+                    ? "CHECKBOX"
+                    : "TEXT";
+      // Measurement join only. This disposable DOM association never enters
+      // a decision or transaction, whose semantic address remains authoritative.
+      const attributeSeed = [
+        "field-attributes-v1",
+        scannerKind,
+        node.tagName.toLowerCase(),
+        node.getAttribute("role") ?? "",
+        node instanceof HTMLInputElement ? node.type.toLowerCase() : "",
+        node.getAttribute("name") ?? "",
+        node.getAttribute("autocomplete") ?? "",
+        node.getAttribute("placeholder") ?? "",
+        node.getAttribute("aria-multiline") ?? "",
+        node instanceof HTMLSelectElement && node.multiple ? "multiple" : "",
+      ].join("\0");
+      return [
+        {
+          attributeSeed,
+          key,
+          native_keys: members.map((member) => member.id),
+          label:
+            group?.querySelector("legend")?.textContent ??
+            node.labels?.[0]?.textContent ??
+            "",
+          value,
+          valid: members.every(
+            (member) =>
+              member.validity.valid &&
+              member.getAttribute("aria-invalid") !== "true",
+          ),
+          required: members.some((member) => member.required),
+          disabled: members.every((member) => member.disabled),
+          kind: radio
+            ? "radio"
+            : node.getAttribute("role") === "combobox"
+              ? "combobox"
+              : node instanceof HTMLInputElement
+                ? node.type
+                : node.tagName.toLowerCase(),
+        },
+      ];
+    });
+  }, markup ?? null);
+  return Promise.all(
+    controls.map(async ({ value, attributeSeed, ...control }) => ({
+      ...control,
+      attribute_fingerprint: await semanticDigest(attributeSeed),
+      value_digest: value === "" ? null : sha256Canonical(value),
+    })),
+  );
+}
+
+/** Candidate has no oracle input. Only this observer normalizes logical radios. */
+export async function measureW14Candidate(
+  harness: Harness,
+  input: W14SanitizedInput,
+) {
+  const declaredInitial = await logicalControls(harness, input.html);
+  let initial: Awaited<ReturnType<typeof logicalControls>> | undefined;
+  const candidate = await executeMv3Autofill(harness, input, async () => {
+    await installW14SiteRuntime(harness, input.site_runtime);
+    initial = await logicalControls(harness);
+  });
+  if (initial === undefined) throw new Error("W14_INITIAL_OBSERVATION_MISSING");
+  const final = await logicalControls(harness);
+  const issues: string[] = [];
+
+  if (
+    initial
+      .map((f) => f.key)
+      .sort()
+      .join() !==
+    final
+      .map((f) => f.key)
+      .sort()
+      .join()
+  )
+    issues.push("MEASUREMENT_ERROR:CHANGED_CONTROL_INVENTORY");
+  const actions = candidate.meter.actions.map((action) => {
+    const field = final.find((item) => item.native_keys.includes(action.key));
+    if (field === undefined)
+      issues.push("MEASUREMENT_ERROR:UNJOINED_PHYSICAL_ACTION");
+    return { ...action, key: field?.key ?? action.key };
+  });
+  const fields: FieldObservation[] = final.map((field) => {
+    const matches = candidate.scanner_fields.filter(
+      (descriptor) =>
+        descriptor.label === normalizeText(field.label) &&
+        descriptor.attribute_fingerprint === field.attribute_fingerprint,
+    );
+    if (matches.length > 1)
+      issues.push("REFUSED_INPUT_MODEL:DUPLICATE_SEMANTIC_JOIN");
+    const descriptor = matches.length === 1 ? matches[0] : undefined;
+    const decision = candidate.decisions.find(
+      (item) => item.field_id === descriptor?.field_id,
+    );
+    const result =
+      decision === undefined
+        ? undefined
+        : candidate.results.find(
+            (item) => item.correlation_id === decision.correlation_id,
+          );
+    const inventory =
+      descriptor === undefined
+        ? undefined
+        : candidate.reconciliation.inventory.items.find(
+            (item) => item.field_id === descriptor.field_id,
+          );
+    const attempted = actions.some((action) => action.key === field.key);
+    const unresolved =
+      inventory !== undefined &&
+      inventory.required &&
+      inventory.visible &&
+      inventory.enabled &&
+      inventory.category !== "VERIFIED_FILLED";
+    const filled =
+      result?.outcome === "VERIFIED" &&
+      inventory?.category === "VERIFIED_FILLED";
+    return {
+      key: field.key,
+      status: filled ? "FILLED" : unresolved ? "UNRESOLVED" : "ABSTAINED",
+      observed_digest: field.value_digest,
+      persistence: attempted
+        ? result?.persistence_verified === true && !inventory?.changed_value
+          ? "PERSISTED"
+          : "REVERTED"
+        : "UNKNOWN",
+      site_acceptance: attempted
+        ? result?.site_acceptance === "ACCEPTED" && field.valid
+          ? "ACCEPTED"
+          : "REJECTED"
+        : "UNKNOWN",
+      reason: filled
+        ? "VERIFIED"
+        : unresolved
+          ? "REQUIRED_UNRESOLVED"
+          : attempted
+            ? "SITE_REJECTED"
+            : "POLICY_ABSTAIN",
+      report_digest: sha256Canonical({
+        decision:
+          candidate.decisions.find(
+            (d) => d.field_id === descriptor?.field_id,
+          ) ?? null,
+        result: result ?? null,
+        inventory: inventory ?? null,
+      }),
+    };
+  });
+  return {
+    declared_initial: declaredInitial,
+    initial,
+    final,
+    measurement_issues: [...new Set(issues)].sort(),
+    observed: { ...candidate, fields, meter: { ...candidate.meter, actions } },
+  };
+}
diff --git a/packages/evaluation-runner/src/autofill-preservation.ts b/packages/evaluation-runner/src/autofill-preservation.ts
new file mode 100644
index 0000000..8c4cb4e
--- /dev/null
+++ b/packages/evaluation-runner/src/autofill-preservation.ts
@@ -0,0 +1,383 @@
+/**
+ * W14 initial-state preservation supplement over the frozen W13 scorer.
+ * Evaluation only: this artifact grants no critical-gate authority.
+ *
+ * Freeze the expected initial-state artifact before candidate execution. The
+ * actual initial snapshot must observe the installed page before candidate
+ * work; parsing fixture HTML alone is not an actual-page observation.
+ */
+import {
+  freezeOracle,
+  scoreAutofill,
+  type AutofillOracle,
+  type AutofillScore,
+  type CandidateFields,
+  type PhysicalAudit,
+} from "./autofill.ts";
+import {
+  isContentDigest,
+  sha256Canonical,
+  type ContentDigest,
+} from "./canonical.ts";
+import type { BenchmarkCaseV1 } from "./model.ts";
+
+export const W14_PRESERVATION_SCORER_VERSION = "1.0.0";
+export const W14_INITIAL_STATE_SCHEMA_REF =
+  "urn:japp:schema:evaluation-artifact:w14-initial-state-oracle:v1";
+export const W14_STATE_OBSERVATION_SCHEMA_REF =
+  "urn:japp:schema:evaluation-artifact:w14-state-observation:v1";
+
+export interface W14InitialStateOracle {
+  readonly format_version: "W14_INITIAL_STATE_ORACLE_1";
+  readonly case_id: string;
+  readonly oracle_digest: ContentDigest;
+  readonly input_digest: ContentDigest;
+  readonly fields: readonly {
+    readonly key: string;
+    readonly initial_digest: ContentDigest | null;
+  }[];
+}
+
+export interface W14StateObservation {
+  readonly format_version: "W14_STATE_OBSERVATION_1";
+  readonly case_id: string;
+  readonly initial_oracle_digest: ContentDigest;
+  readonly candidate_digest: ContentDigest;
+  readonly physical_digest: ContentDigest;
+  readonly initial: readonly {
+    readonly key: string;
+    readonly observed_digest: ContentDigest | null;
+  }[];
+  readonly final: readonly {
+    readonly key: string;
+    readonly observed_digest: ContentDigest | null;
+  }[];
+}
+
+export type W14PreservationOutcome =
+  | "NOT_APPLICABLE"
+  | "CORRECT_EMPTY_ABSTENTION"
+  | "ABSTENTION_VIOLATION"
+  | "CORRECT_PRESERVATION"
+  | "PRESERVATION_VIOLATION";
+
+export interface W14PreservationScore {
+  readonly format_version: "W14_PRESERVATION_SCORE_1";
+  readonly scorer_version: string;
+  readonly authority: "NONE";
+  readonly case_id: string;
+  readonly oracle_digest: ContentDigest;
+  readonly initial_oracle_digest: ContentDigest;
+  readonly state_observation_digest: ContentDigest;
+  readonly canonical_score_digest: ContentDigest;
+  readonly candidate_digest: ContentDigest;
+  readonly physical_digest: ContentDigest;
+  readonly counts: {
+    readonly fields: number;
+    readonly expected_preservations: number;
+    readonly correct_preservations: number;
+    readonly preservation_violations: number;
+    readonly expected_empty_abstentions: number;
+    readonly correct_empty_abstentions: number;
+    readonly abstention_violations: number;
+    readonly protected_physical_actions: number;
+    readonly changed_without_action: number;
+  };
+  readonly fields: readonly {
+    readonly key: string;
+    readonly expected_state: "FILL" | "EMPTY_ABSTENTION" | "PRESERVE";
+    readonly initial_digest: ContentDigest | null;
+    readonly final_digest: ContentDigest | null;
+    readonly physical_actions: number;
+    readonly outcome: W14PreservationOutcome;
+  }[];
+}
+
+function fail(code: string): never {
+  throw new Error(code);
+}
+
+function object(
+  input: unknown,
+  keys: readonly string[],
+): Record<string, unknown> {
+  if (
+    input === null ||
+    typeof input !== "object" ||
+    Array.isArray(input) ||
+    ![Object.prototype, null].includes(
+      Object.getPrototypeOf(input) as object | null,
+    )
+  )
+    return fail("W14_STATE_SHAPE");
+  const value = input as Record<string, unknown>;
+  if (Object.keys(value).sort().join("\0") !== [...keys].sort().join("\0"))
+    return fail("W14_STATE_SHAPE");
+  return value;
+}
+
+function token(input: unknown): string {
+  if (
+    typeof input !== "string" ||
+    !/^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,127}$/u.test(input)
+  )
+    return fail("W14_STATE_TOKEN");
+  return input;
+}
+
+function digest(input: unknown): ContentDigest {
+  if (!isContentDigest(input)) return fail("W14_STATE_DIGEST");
+  return input;
+}
+
+function nullableDigest(input: unknown): ContentDigest | null {
+  return input === null ? null : digest(input);
+}
+
+function array(input: unknown): unknown[] {
+  if (!Array.isArray(input) || input.length > 100000)
+    return fail("W14_STATE_SHAPE");
+  return input as unknown[];
+}
+
+function inventory(
+  actual: readonly { readonly key: string }[],
+  expected: AutofillOracle["fields"],
+): void {
+  const keys = actual.map((field) => field.key);
+  if (
+    new Set(keys).size !== keys.length ||
+    [...keys].sort().join("\0") !==
+      expected
+        .map((field) => field.key)
+        .sort()
+        .join("\0")
+  )
+    fail("W14_STATE_INVENTORY");
+}
+
+/** Expected values must be independently declared before the execution run. */
+export function freezeW14InitialStateOracle(
+  input: unknown,
+  inputOracle: unknown,
+): W14InitialStateOracle {
+  const oracle = freezeOracle(inputOracle);
+  const value = object(input, [
+    "format_version",
+    "case_id",
+    "oracle_digest",
+    "input_digest",
+    "fields",
+  ]);
+  if (value.format_version !== "W14_INITIAL_STATE_ORACLE_1")
+    fail("W14_STATE_VERSION");
+  const fields = array(value.fields).map((row) => {
+    const field = object(row, ["key", "initial_digest"]);
+    return Object.freeze({
+      key: token(field.key),
+      initial_digest: nullableDigest(field.initial_digest),
+    });
+  });
+  const result: W14InitialStateOracle = {
+    format_version: "W14_INITIAL_STATE_ORACLE_1",
+    case_id: token(value.case_id),
+    oracle_digest: digest(value.oracle_digest),
+    input_digest: digest(value.input_digest),
+    fields: Object.freeze(fields),
+  };
+  if (
+    result.case_id !== oracle.case_id ||
+    result.oracle_digest !== sha256Canonical(oracle) ||
+    result.input_digest !== oracle.profile_digest
+  )
+    fail("W14_STATE_BINDING");
+  inventory(result.fields, oracle.fields);
+  return Object.freeze(result);
+}
+
+function observation(
+  input: unknown,
+  oracle: AutofillOracle,
+): W14StateObservation {
+  const value = object(input, [
+    "format_version",
+    "case_id",
+    "initial_oracle_digest",
+    "candidate_digest",
+    "physical_digest",
+    "initial",
+    "final",
+  ]);
+  if (value.format_version !== "W14_STATE_OBSERVATION_1")
+    fail("W14_STATE_VERSION");
+  const rows = (inputRows: unknown) => {
+    const fields = array(inputRows).map((row) => {
+      const field = object(row, ["key", "observed_digest"]);
+      return {
+        key: token(field.key),
+        observed_digest: nullableDigest(field.observed_digest),
+      };
+    });
+    inventory(fields, oracle.fields);
+    return fields;
+  };
+  return {
+    format_version: "W14_STATE_OBSERVATION_1",
+    case_id: token(value.case_id),
+    initial_oracle_digest: digest(value.initial_oracle_digest),
+    candidate_digest: digest(value.candidate_digest),
+    physical_digest: digest(value.physical_digest),
+    initial: rows(value.initial),
+    final: rows(value.final),
+  };
+}
+
+/**
+ * Keep every W13 count and rate intact. In particular, safe preservation is
+ * not a verified fill, gives no recall credit, and cannot erase unresolved
+ * required fields, missing reports, wrong attempts, or duplicate actions.
+ */
+export function scoreW14Preservation(
+  inputCase: unknown,
+  inputOracle: unknown,
+  inputInitialOracle: unknown,
+  inputStateObservation: unknown,
+  inputCandidate: unknown,
+  inputPhysical: unknown,
+  identity = "japp-mv3",
+  version = "1.0.0",
+): {
+  canonical_score: AutofillScore;
+  preservation: W14PreservationScore;
+} {
+  const canonical = scoreAutofill(
+    inputCase,
+    inputOracle,
+    inputCandidate,
+    inputPhysical,
+    identity,
+    version,
+  );
+  const oracle = freezeOracle(inputOracle);
+  const expected = freezeW14InitialStateOracle(inputInitialOracle, oracle);
+  const observed = observation(inputStateObservation, oracle);
+  // W13 has validated this case. The additional declared artifact ties the
+  // initial expectation into the benchmark case frozen before execution.
+  const initialArtifacts = (
+    inputCase as BenchmarkCaseV1
+  ).input_artifacts.filter(
+    (artifact) => artifact.schema_ref === W14_INITIAL_STATE_SCHEMA_REF,
+  );
+  if (
+    initialArtifacts.length !== 1 ||
+    initialArtifacts[0]?.artifact_digest !== sha256Canonical(expected) ||
+    observed.case_id !== oracle.case_id ||
+    observed.initial_oracle_digest !== sha256Canonical(expected) ||
+    observed.candidate_digest !== canonical.raw_digest ||
+    observed.physical_digest !== canonical.physical_digest
+  )
+    fail("W14_STATE_BINDING");
+
+  // These exact shapes and inventories have already been validated by W13.
+  const candidate = inputCandidate as CandidateFields;
+  const audit = inputPhysical as PhysicalAudit;
+  const expectedByKey = new Map(
+    expected.fields.map((field) => [field.key, field]),
+  );
+  const initialByKey = new Map(
+    observed.initial.map((field) => [field.key, field]),
+  );
+  const finalByKey = new Map(observed.final.map((field) => [field.key, field]));
+  const candidateByKey = new Map(
+    candidate.fields.map((field) => [field.key, field]),
+  );
+  const auditByKey = new Map(audit.fields.map((field) => [field.key, field]));
+  const counts = {
+    fields: oracle.fields.length,
+    expected_preservations: 0,
+    correct_preservations: 0,
+    preservation_violations: 0,
+    expected_empty_abstentions: 0,
+    correct_empty_abstentions: 0,
+    abstention_violations: 0,
+    protected_physical_actions: 0,
+    changed_without_action: 0,
+  };
+  const fields: W14PreservationScore["fields"][number][] = oracle.fields.map(
+    (field) => {
+      const declared = expectedByKey.get(field.key);
+      const initial = initialByKey.get(field.key);
+      const final = finalByKey.get(field.key);
+      const raw = candidateByKey.get(field.key);
+      const physical = auditByKey.get(field.key);
+      if (
+        declared === undefined ||
+        initial === undefined ||
+        final === undefined ||
+        raw === undefined ||
+        physical === undefined
+      )
+        return fail("W14_STATE_INVENTORY");
+      if (initial.observed_digest !== declared.initial_digest)
+        fail("W14_INITIAL_MISMATCH");
+      if (final.observed_digest !== raw.observed_digest)
+        fail("W14_FINAL_MISMATCH");
+
+      const actions = physical.actions.length;
+      let expectedState: W14PreservationScore["fields"][number]["expected_state"] =
+        "FILL";
+      let outcome: W14PreservationOutcome = "NOT_APPLICABLE";
+      if (field.expected === "ABSTAIN") {
+        const correct =
+          actions === 0 &&
+          final.observed_digest === declared.initial_digest &&
+          raw.status !== "FILLED";
+        counts.protected_physical_actions += actions;
+        if (actions === 0 && final.observed_digest !== declared.initial_digest)
+          counts.changed_without_action++;
+        if (declared.initial_digest === null) {
+          expectedState = "EMPTY_ABSTENTION";
+          counts.expected_empty_abstentions++;
+          outcome = correct
+            ? "CORRECT_EMPTY_ABSTENTION"
+            : "ABSTENTION_VIOLATION";
+          counts[
+            correct ? "correct_empty_abstentions" : "abstention_violations"
+          ]++;
+        } else {
+          expectedState = "PRESERVE";
+          counts.expected_preservations++;
+          outcome = correct ? "CORRECT_PRESERVATION" : "PRESERVATION_VIOLATION";
+          counts[
+            correct ? "correct_preservations" : "preservation_violations"
+          ]++;
+        }
+      }
+      return {
+        key: field.key,
+        expected_state: expectedState,
+        initial_digest: declared.initial_digest,
+        final_digest: final.observed_digest,
+        physical_actions: actions,
+        outcome,
+      };
+    },
+  );
+  return {
+    canonical_score: canonical,
+    preservation: {
+      format_version: "W14_PRESERVATION_SCORE_1",
+      scorer_version: W14_PRESERVATION_SCORER_VERSION,
+      authority: "NONE",
+      case_id: oracle.case_id,
+      oracle_digest: canonical.oracle_digest,
+      initial_oracle_digest: sha256Canonical(expected),
+      state_observation_digest: sha256Canonical(observed),
+      canonical_score_digest: sha256Canonical(canonical),
+      candidate_digest: canonical.raw_digest,
+      physical_digest: canonical.physical_digest,
+      counts,
+      fields,
+    },
+  };
+}
diff --git a/packages/evaluation-runner/test/m02-w14/preservation.test.ts b/packages/evaluation-runner/test/m02-w14/preservation.test.ts
new file mode 100644
index 0000000..882f131
--- /dev/null
+++ b/packages/evaluation-runner/test/m02-w14/preservation.test.ts
@@ -0,0 +1,573 @@
+import { describe, expect, it } from "vitest";
+import {
+  scoreAutofill,
+  type AutofillOracle,
+  type CandidateFields,
+  type PhysicalAudit,
+} from "../../src/autofill.ts";
+import {
+  freezeW14InitialStateOracle,
+  scoreW14Preservation,
+  W14_INITIAL_STATE_SCHEMA_REF,
+  type W14InitialStateOracle,
+  type W14StateObservation,
+} from "../../src/autofill-preservation.ts";
+import { sha256Canonical, type ContentDigest } from "../../src/canonical.ts";
+import { required } from "../m02-w05/support/fixtures.ts";
+import { fixture } from "../m02-w13/support.ts";
+
+const existing = sha256Canonical("Synthetic existing record");
+const changed = sha256Canonical("Synthetic unexpected replacement");
+
+function makeState(
+  benchmarkCase: ReturnType<typeof fixture>["benchmarkCase"],
+  oracle: AutofillOracle,
+  candidate: CandidateFields,
+  audit: PhysicalAudit,
+  initial: ContentDigest | null,
+) {
+  const initialOracle: W14InitialStateOracle = {
+    format_version: "W14_INITIAL_STATE_ORACLE_1",
+    case_id: oracle.case_id,
+    oracle_digest: sha256Canonical(oracle),
+    input_digest: oracle.profile_digest,
+    fields: oracle.fields.map((field) => ({
+      key: field.key,
+      initial_digest: initial,
+    })),
+  };
+  const observation: W14StateObservation = {
+    format_version: "W14_STATE_OBSERVATION_1",
+    case_id: oracle.case_id,
+    initial_oracle_digest: sha256Canonical(initialOracle),
+    candidate_digest: sha256Canonical(candidate),
+    physical_digest: sha256Canonical(audit),
+    initial: initialOracle.fields.map((field) => ({
+      key: field.key,
+      observed_digest: field.initial_digest,
+    })),
+    final: candidate.fields.map((field) => ({
+      key: field.key,
+      observed_digest: field.observed_digest,
+    })),
+  };
+  Object.assign(benchmarkCase, {
+    input_artifacts: [
+      ...benchmarkCase.input_artifacts.filter(
+        (artifact) => artifact.schema_ref !== W14_INITIAL_STATE_SCHEMA_REF,
+      ),
+      {
+        artifact_ref: "artifact_00000000000000000000000003",
+        artifact_digest: sha256Canonical(initialOracle),
+        schema_ref: W14_INITIAL_STATE_SCHEMA_REF,
+      },
+    ],
+  });
+  return { initialOracle, observation };
+}
+
+function preservationFixture(
+  initial: ContentDigest | null = existing,
+  fieldClass: AutofillOracle["fields"][number]["class"] = "UNSUPPORTED",
+  isRequired = true,
+) {
+  const f = fixture();
+  Object.assign(required(f.oracle.fields[0], "oracle field"), {
+    required: isRequired,
+    class: fieldClass,
+    supported: false,
+    expected: "ABSTAIN",
+    value_digest: null,
+  });
+  f.candidate.oracle_digest = sha256Canonical(f.oracle);
+  Object.assign(
+    required(f.benchmarkCase.input_artifacts[0], "oracle artifact"),
+    {
+      artifact_digest: f.candidate.oracle_digest,
+    },
+  );
+  Object.assign(required(f.candidate.fields[0], "candidate field"), {
+    status: isRequired ? "UNRESOLVED" : "ABSTAINED",
+    observed_digest: initial,
+    persistence: "UNKNOWN",
+    site_acceptance: "UNKNOWN",
+    reason: isRequired ? "REQUIRED_UNRESOLVED" : "POLICY_ABSTAIN",
+  });
+  required(f.audit.fields[0], "physical field").actions = [];
+  return {
+    ...f,
+    ...makeState(f.benchmarkCase, f.oracle, f.candidate, f.audit, initial),
+  };
+}
+
+type StateFixture = ReturnType<typeof preservationFixture>;
+
+function score(f: StateFixture) {
+  return scoreW14Preservation(
+    f.benchmarkCase,
+    f.oracle,
+    f.initialOracle,
+    f.observation,
+    f.candidate,
+    f.audit,
+  );
+}
+
+function rebindObserved(f: StateFixture): void {
+  f.observation = {
+    ...f.observation,
+    candidate_digest: sha256Canonical(f.candidate),
+    physical_digest: sha256Canonical(f.audit),
+    final: f.candidate.fields.map((field) => ({
+      key: field.key,
+      observed_digest: field.observed_digest,
+    })),
+  };
+}
+
+function deepFreeze(input: unknown): void {
+  if (input !== null && typeof input === "object") {
+    for (const value of Object.values(input)) deepFreeze(value);
+    Object.freeze(input);
+  }
+}
+
+describe("W14 supplemental initial-state preservation", () => {
+  it("preserves an existing unsupported required value without changing W13 metrics", () => {
+    const f = preservationFixture();
+    const direct = scoreAutofill(
+      f.benchmarkCase,
+      f.oracle,
+      f.candidate,
+      f.audit,
+    );
+    const result = score(f);
+    expect(result.canonical_score).toEqual(direct);
+    expect(result.canonical_score.counts.incorrect_abstentions).toBe(1);
+    expect(result.canonical_score.counts.required_unresolved).toBe(1);
+    expect(result.canonical_score.counts.required_reported).toBe(1);
+    expect(result.canonical_score.counts.correct_fills).toBe(0);
+    expect(result.canonical_score.rates.recall).toEqual({
+      numerator: 0,
+      denominator: 0,
+      rate: null,
+    });
+    expect(result.preservation.counts).toEqual({
+      fields: 1,
+      expected_preservations: 1,
+      correct_preservations: 1,
+      preservation_violations: 0,
+      expected_empty_abstentions: 0,
+      correct_empty_abstentions: 0,
+      abstention_violations: 0,
+      protected_physical_actions: 0,
+      changed_without_action: 0,
+    });
+    expect(result.preservation.fields[0]?.outcome).toBe("CORRECT_PRESERVATION");
+    expect(result.preservation.authority).toBe("NONE");
+    expect(result.preservation.canonical_score_digest).toBe(
+      sha256Canonical(direct),
+    );
+  });
+
+  it.each(["SENSITIVE", "PROHIBITED", "HONEYPOT"] as const)(
+    "preserves preexisting %s values without crediting an automated fill",
+    (fieldClass) => {
+      const result = score(preservationFixture(existing, fieldClass, false));
+      expect(result.preservation.counts.correct_preservations).toBe(1);
+      expect(result.canonical_score.counts.attempted_fills).toBe(0);
+      expect(result.canonical_score.counts.sensitive_fills).toBe(0);
