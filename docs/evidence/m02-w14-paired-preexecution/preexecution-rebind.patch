+});
+test("STRUCTURAL_TEST_ONLY changing runtime bytes invalidates the source commitment", () => {
+  const f = fixture();
+  try {
+    f.write("apps/extension/src/open-dom.ts", "STRUCTURAL_TEST_ONLY_CHANGED");
