{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:japp:schema:test-fixture:scenario-bundle:v1",
  "x-japp-schema-version": "1.0.0",
  "title": "Profile-job scenario bundle",
  "description": "TEST-ONLY bundle linking one profile, source resume, job, complete requirement evaluations, claims, and gaps.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "entity_type",
    "schema_ref",
    "schema_version",
    "metadata",
    "profile_ref",
    "resume_ref",
    "job_ref",
    "expected_outcome",
    "evaluations",
    "coverage_tags"
  ],
  "properties": {
    "id": {
      "$ref": "urn:japp:schema:test-fixture:common:v1#/$defs/stableId"
    },
    "entity_type": {
      "const": "SCENARIO_BUNDLE"
    },
    "schema_ref": {
      "const": "urn:japp:schema:test-fixture:scenario-bundle:v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "metadata": {
      "$ref": "urn:japp:schema:test-fixture:common:v1#/$defs/fixtureMetadata"
    },
    "profile_ref": {
      "$ref": "urn:japp:schema:test-fixture:common:v1#/$defs/stableId"
    },
    "resume_ref": {
      "$ref": "urn:japp:schema:test-fixture:common:v1#/$defs/stableId"
    },
    "job_ref": {
      "$ref": "urn:japp:schema:test-fixture:common:v1#/$defs/stableId"
    },
    "expected_outcome": {
      "type": "string",
      "enum": [
        "ABSTAIN",
        "BLOCK_FIELD_POLICY",
        "BLOCK_INELIGIBLE",
        "PROCEED_WITH_GAPS",
        "REQUIRE_CONFIRMATION"
      ]
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_ref",
          "classification",
          "result_type",
          "result_ref",
          "expected_action"
        ],
        "properties": {
          "requirement_ref": {
            "$ref": "urn:japp:schema:test-fixture:common:v1#/$defs/stableId"
          },
          "classification": {
            "$ref": "urn:japp:schema:test-fixture:common:v1#/$defs/supportClassification"
          },
          "result_type": {
            "type": "string",
            "enum": ["SUPPORTED_CLAIM", "UNSUPPORTED_GAP"]
          },
          "result_ref": {
            "$ref": "urn:japp:schema:test-fixture:common:v1#/$defs/stableId"
          },
          "expected_action": {
            "type": "string",
            "enum": [
              "ABSTAIN",
              "BLOCK_AND_EXPLAIN",
              "REQUIRE_CONFIRMATION",
              "USE_SUPPORTED_EVIDENCE"
            ]
          }
        }
      },
      "minItems": 3,
      "maxItems": 3
    },
    "coverage_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      },
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true
    }
  }
}
