{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:japp:schema:test-fixture:expected-requirement:v1",
  "x-japp-schema-version": "1.0.0",
  "title": "Normalized expected job requirement",
  "description": "TEST-ONLY independently reviewable expected normalization for one anchored synthetic job requirement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "entity_type",
    "schema_ref",
    "schema_version",
    "metadata",
    "job_ref",
    "importance",
    "requirement_kind",
    "normalized_text",
    "source_anchor_id",
    "source_text_sha256",
    "requirement_tag",
    "keyword_trap",
    "related_evidence_trap"
  ],
  "properties": {
    "id": {
      "$ref": "urn:japp:schema:test-fixture:common:v1#/$defs/stableId"
    },
    "entity_type": {
      "const": "EXPECTED_REQUIREMENT"
    },
    "schema_ref": {
      "const": "urn:japp:schema:test-fixture:expected-requirement:v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "metadata": {
      "$ref": "urn:japp:schema:test-fixture:common:v1#/$defs/fixtureMetadata"
    },
    "job_ref": {
      "$ref": "urn:japp:schema:test-fixture:common:v1#/$defs/stableId"
    },
    "importance": {
      "$ref": "urn:japp:schema:test-fixture:common:v1#/$defs/requirementImportance"
    },
    "requirement_kind": {
      "type": "string",
      "enum": [
        "CERTIFICATION",
        "EDUCATION",
        "ELIGIBILITY",
        "EXPERIENCE",
        "LOCATION",
        "SKILL"
      ]
    },
    "normalized_text": {
      "type": "string",
      "minLength": 5,
      "maxLength": 300
    },
    "source_anchor_id": {
      "type": "string",
      "pattern": "^job-[0-9]{2}\\.requirements\\.[0-9]{2}$"
    },
    "source_text_sha256": {
      "$ref": "urn:japp:schema:test-fixture:common:v1#/$defs/contentDigest"
    },
    "requirement_tag": {
      "$ref": "urn:japp:schema:test-fixture:common:v1#/$defs/factKey"
    },
    "keyword_trap": {
      "type": "boolean"
    },
    "related_evidence_trap": {
      "type": "boolean"
    }
  }
}
