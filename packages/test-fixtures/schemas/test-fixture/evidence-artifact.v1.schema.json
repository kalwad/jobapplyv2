{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:japp:schema:test-fixture:evidence-artifact:v1",
  "x-japp-schema-version": "1.0.0",
  "title": "Synthetic career evidence artifact",
  "description": "TEST-ONLY immutable synthetic evidence used to review M02-W01 expected results.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "entity_type",
    "schema_ref",
    "schema_version",
    "metadata",
    "profile_ref",
    "category",
    "organization",
    "statement",
    "fact_keys",
    "effective_period",
    "assertion_approval",
    "field_records",
    "requirement_relations"
  ],
  "properties": {
    "id": {
      "$ref": "urn:japp:schema:test-fixture:common:v1#/$defs/stableId"
    },
    "entity_type": {
      "const": "EVIDENCE_ARTIFACT"
    },
    "schema_ref": {
      "const": "urn:japp:schema:test-fixture:evidence-artifact:v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "metadata": {
      "$ref": "urn:japp:schema:test-fixture:common:v1#/$defs/fixtureMetadata"
    },
    "profile_ref": {
      "$ref": "urn:japp:schema:test-fixture:common:v1#/$defs/stableId"
    },
    "category": {
      "type": "string",
      "enum": [
        "CREDENTIAL_RECORD",
        "EDUCATION_RECORD",
        "EMPLOYMENT_RECORD",
        "PROJECT_RECORD",
        "USER_ASSERTION"
      ]
    },
    "organization": {
      "type": "string",
      "pattern": "^Synthetic (Employer|Institute|Project|Candidate Record) [0-9]{2}([ -][A-Z])?$",
      "maxLength": 100
    },
    "statement": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "fact_keys": {
      "type": "array",
      "items": {
        "$ref": "urn:japp:schema:test-fixture:common:v1#/$defs/factKey"
      },
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true
    },
    "effective_period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {
          "$ref": "urn:japp:schema:test-fixture:common:v1#/$defs/calendarDate"
        },
        "end": {
          "$ref": "urn:japp:schema:test-fixture:common:v1#/$defs/calendarDate"
        }
      }
    },
    "assertion_approval": {
      "type": "string",
      "enum": ["NOT_APPLICABLE", "USER_APPROVED"]
    },
    "field_records": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field_concept", "disclosure_text"],
        "properties": {
          "field_concept": {
            "type": "string",
            "enum": [
              "DEMOGRAPHIC_DISCLOSURE",
              "RELOCATION_PREFERENCE",
              "SALARY_EXPECTATION",
              "WORK_AUTHORIZATION"
            ]
          },
          "recorded_value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "x-japp-sensitivity": "SENSITIVE",
            "x-japp-redaction": "REDACT_VALUE"
          },
          "disclosure_text": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300,
            "x-japp-sensitivity": "SENSITIVE",
            "x-japp-redaction": "REDACT_VALUE"
          }
        }
      }
    },
    "concurrency_group": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "requirement_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_ref", "relation"],
        "properties": {
          "requirement_ref": {
            "$ref": "urn:japp:schema:test-fixture:common:v1#/$defs/stableId"
          },
          "relation": {
            "type": "string",
            "enum": [
              "CONTRADICTS",
              "DIRECT",
              "PARTIAL",
              "STRONG_RELATED",
              "USER_ASSERTED"
            ]
          }
        }
      },
      "minItems": 0,
      "maxItems": 64
    }
  }
}
