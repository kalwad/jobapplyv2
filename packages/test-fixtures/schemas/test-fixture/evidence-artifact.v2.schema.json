{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:japp:schema:test-fixture:evidence-artifact:v2",
  "x-japp-schema-version": "2.0.0",
  "title": "Synthetic career evidence artifact",
  "description": "TEST-ONLY immutable synthetic evidence used to review M02-W01 expected results.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "entity_type",
    "schema_ref",
    "schema_version",
    "metadata",
    "profile_ref",
    "category",
    "organization",
    "statement",
    "fact_keys",
    "effective_period",
    "temporal_semantics",
    "assertion_approval",
    "field_records",
    "requirement_relations"
  ],
  "properties": {
    "id": {
      "$ref": "urn:japp:schema:test-fixture:common:v2#/$defs/stableId"
    },
    "entity_type": {
      "const": "EVIDENCE_ARTIFACT"
    },
    "schema_ref": {
      "const": "urn:japp:schema:test-fixture:evidence-artifact:v2"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "metadata": {
      "$ref": "urn:japp:schema:test-fixture:common:v2#/$defs/fixtureMetadata"
    },
    "profile_ref": {
      "$ref": "urn:japp:schema:test-fixture:common:v2#/$defs/stableId"
    },
    "category": {
      "type": "string",
      "enum": [
        "CREDENTIAL_RECORD",
        "EDUCATION_RECORD",
        "EMPLOYMENT_RECORD",
        "PROJECT_RECORD",
        "USER_ASSERTION"
      ]
    },
    "organization": {
      "type": "string",
      "pattern": "^Synthetic (Employer|Institute|Project|Candidate Record) [0-9]{2}([ -][A-Z])?$",
      "maxLength": 100
    },
    "statement": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "fact_keys": {
      "type": "array",
      "items": {
        "$ref": "urn:japp:schema:test-fixture:common:v2#/$defs/factKey"
      },
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true
    },
    "effective_period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start"],
      "properties": {
        "start": {
          "$ref": "urn:japp:schema:test-fixture:common:v2#/$defs/calendarDate"
        },
        "end": {
          "$ref": "urn:japp:schema:test-fixture:common:v2#/$defs/calendarDate"
        }
      }
    },
    "temporal_semantics": {
      "type": "string",
      "enum": [
        "ACTIVITY_INTERVAL",
        "ASSERTION_FRESHNESS",
        "CREDENTIAL_VALIDITY",
        "EDUCATION_ATTENDANCE"
      ]
    },
    "education_state": {
      "type": "string",
      "enum": ["COMPLETED", "IN_PROGRESS", "WITHDRAWN"]
    },
    "credential_validity_basis": {
      "type": "string",
      "enum": ["BOUNDED", "NON_EXPIRING", "UNKNOWN"]
    },
    "revoked_on": {
      "$ref": "urn:japp:schema:test-fixture:common:v2#/$defs/calendarDate"
    },
    "assertion_approval": {
      "type": "string",
      "enum": ["NOT_APPLICABLE", "USER_APPROVED"]
    },
    "field_records": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field_record_id",
          "field_concept",
          "disclosure_text",
          "recorded_on"
        ],
        "properties": {
          "field_record_id": {
            "$ref": "urn:japp:schema:test-fixture:common:v2#/$defs/stableId"
          },
          "field_concept": {
            "type": "string",
            "enum": [
              "DEMOGRAPHIC_DISCLOSURE",
              "RELOCATION_PREFERENCE",
              "SALARY_EXPECTATION",
              "SPONSORSHIP_REQUIREMENT",
              "WORK_AUTHORIZATION"
            ]
          },
          "recorded_value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "x-japp-sensitivity": "SENSITIVE",
            "x-japp-redaction": "REDACT_VALUE"
          },
          "disclosure_text": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300,
            "x-japp-sensitivity": "SENSITIVE",
            "x-japp-redaction": "REDACT_VALUE"
          },
          "recorded_on": {
            "$ref": "urn:japp:schema:test-fixture:common:v2#/$defs/calendarDate"
          },
          "valid_through": {
            "$ref": "urn:japp:schema:test-fixture:common:v2#/$defs/calendarDate"
          }
        }
      }
    },
    "concurrency_group": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "requirement_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_ref", "relation"],
        "properties": {
          "requirement_ref": {
            "$ref": "urn:japp:schema:test-fixture:common:v2#/$defs/stableId"
          },
          "relation": {
            "type": "string",
            "enum": [
              "CONTRADICTS",
              "DIRECT",
              "PARTIAL",
              "STRONG_RELATED",
              "USER_ASSERTED"
            ]
          }
        }
      },
      "minItems": 0,
      "maxItems": 64
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "category": { "const": "CREDENTIAL_RECORD" } },
        "required": ["category"]
      },
      "then": {
        "properties": {
          "temporal_semantics": { "const": "CREDENTIAL_VALIDITY" },
          "assertion_approval": { "const": "NOT_APPLICABLE" },
          "field_records": { "type": "array", "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": { "const": "CREDENTIAL_RECORD" },
          "credential_validity_basis": { "const": "BOUNDED" }
        },
        "required": ["category", "credential_validity_basis"]
      },
      "then": {}
    },
    {
      "if": {
        "properties": { "category": { "const": "EDUCATION_RECORD" } },
        "required": ["category"]
      },
      "then": {
        "properties": {
          "temporal_semantics": { "const": "EDUCATION_ATTENDANCE" },
          "assertion_approval": { "const": "NOT_APPLICABLE" },
          "field_records": { "type": "array", "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "type": "string",
            "enum": ["EMPLOYMENT_RECORD", "PROJECT_RECORD"]
          }
        },
        "required": ["category"]
      },
      "then": {
        "properties": {
          "temporal_semantics": { "const": "ACTIVITY_INTERVAL" },
          "assertion_approval": { "const": "NOT_APPLICABLE" },
          "field_records": { "type": "array", "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "category": { "const": "USER_ASSERTION" } },
        "required": ["category"]
      },
      "then": {
        "properties": {
          "temporal_semantics": { "const": "ASSERTION_FRESHNESS" },
          "assertion_approval": { "const": "USER_APPROVED" },
          "field_records": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5
          }
        }
      }
    }
  ]
}
