{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:japp:schema:platform:installer-state:v1",
  "x-japp-schema-version": "1.0.0",
  "title": "Installer state and result",
  "description": "Bounded installer state for a packaged build: package identity, version, platform, architecture, format, artifact digest and signature state, channel, installed version, lifecycle state, interruption and recovery state, user-data preservation, native-host cleanup, and finite failure reasons. No installer command, script, registry modification, download URL, network request, signing key, or filesystem path is representable, and this contract installs nothing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "installer_state_id",
    "package_token",
    "package_version",
    "platform_id",
    "architecture",
    "package_format",
    "artifact",
    "signature_state",
    "channel",
    "scope",
    "state",
    "interrupted",
    "user_data_preservation",
    "native_host_cleanup",
    "reason_codes",
    "observed_at",
    "provenance"
  ],
  "properties": {
    "installer_state_id": {
      "$ref": "urn:japp:schema:common:stable-id:v1#/$defs/stableId"
    },
    "package_token": {
      "$ref": "urn:japp:schema:common:contract-text:v1#/$defs/boundedToken"
    },
    "package_version": {
      "$ref": "urn:japp:schema:platform:vocabulary:v1#/$defs/productVersion"
    },
    "platform_id": {
      "$ref": "urn:japp:schema:platform:vocabulary:v1#/$defs/certifiedPlatformId"
    },
    "architecture": {
      "$ref": "urn:japp:schema:platform:vocabulary:v1#/$defs/architecture"
    },
    "package_format": {
      "$ref": "urn:japp:schema:platform:vocabulary:v1#/$defs/packageFormat"
    },
    "artifact": {
      "$ref": "urn:japp:schema:platform:vocabulary:v1#/$defs/artifactIdentity"
    },
    "signature_state": {
      "$ref": "urn:japp:schema:platform:vocabulary:v1#/$defs/signatureState"
    },
    "channel": {
      "$ref": "urn:japp:schema:platform:vocabulary:v1#/$defs/distributionChannel"
    },
    "scope": {
      "$ref": "urn:japp:schema:platform:vocabulary:v1#/$defs/installationScope"
    },
    "state": {
      "$ref": "urn:japp:schema:platform:vocabulary:v1#/$defs/installerState"
    },
    "installed_version": {
      "$ref": "urn:japp:schema:platform:vocabulary:v1#/$defs/productVersion"
    },
    "interrupted": {
      "type": "boolean"
    },
    "recovery_completed": {
      "type": "boolean"
    },
    "user_data_preservation": {
      "$ref": "urn:japp:schema:platform:vocabulary:v1#/$defs/userDataPreservation"
    },
    "native_host_cleanup": {
      "$ref": "urn:japp:schema:platform:vocabulary:v1#/$defs/nativeHostCleanupState"
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "$ref": "urn:japp:schema:platform:vocabulary:v1#/$defs/platformReasonCode"
      },
      "minItems": 0,
      "maxItems": 8
    },
    "remediation_message": {
      "$ref": "urn:japp:schema:platform:vocabulary:v1#/$defs/boundedUserMessage"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "urn:japp:schema:common:stable-id:v1#/$defs/stableId"
      },
      "minItems": 0,
      "maxItems": 16
    },
    "observed_at": {
      "$ref": "urn:japp:schema:common:timestamp-utc:v1#/$defs/utcTimestamp"
    },
    "provenance": {
      "$ref": "urn:japp:schema:common:provenance:v1#/$defs/provenance"
    }
  }
}
