{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-shell",
  "description": "Read app versions and finite native local service diagnostics from the local main window.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:app:allow-version",
    "core:app:allow-tauri-version",
    "allow-read-service-diagnostics",
    "allow-cancel-service-request"
  ]
}
