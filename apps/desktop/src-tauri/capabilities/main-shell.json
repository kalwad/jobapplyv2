{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-shell",
  "description": "Read app versions and finite native local service diagnostics, and allow native page zoom from the local main window.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:app:allow-version",
    "core:app:allow-tauri-version",
    "allow-read-service-diagnostics",
    "allow-cancel-service-request",
    "core:webview:allow-set-webview-zoom"
  ]
}
