{
  "name": "japp-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for the local-first job application platform (spec JAPP-MASTER-001). Neutral naming per owner decision OD-003.",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.17.0"
  },
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write . && uv run ruff format services scripts/verify.py scripts/validate_status.py scripts/traceability.py scripts/doctor.py scripts/check_portability.py scripts/portability.py scripts/tests packages/contracts/test/contract/adapters/python_adapter.py && cargo fmt --manifest-path services/native-host/Cargo.toml && cargo fmt --manifest-path packages/contracts/test/contract/rust-harness/Cargo.toml",
    "format:check": "uv run python scripts/verify.py --suite format",
    "generate:contracts": "node scripts/generate-contracts.ts",
    "contracts:corpus:update-manifest": "node packages/contracts/test/contract/adapters/update-corpus-manifest.ts --update-corpus-manifest",
    "contracts:compatibility:check": "node packages/contracts/test/contract/breaking/check-compatibility.ts --check",
    "contracts:compatibility:update-baseline": "node packages/contracts/test/contract/breaking/check-compatibility.ts --update-baseline",
    "typecheck": "uv run python scripts/verify.py --suite typecheck",
    "test": "uv run python scripts/verify.py --suite unit-ts",
    "test:contract": "uv run python scripts/verify.py --suite contract",
    "test:e2e": "uv run python scripts/verify.py --suite e2e-browser",
    "test:visual": "uv run python scripts/verify.py --suite visual",
    "test:python": "uv run python scripts/verify.py --suite python",
    "test:rust": "uv run python scripts/verify.py --suite rust",
    "test:browser-smoke": "playwright test",
    "traceability:generate": "uv run python scripts/traceability.py generate",
    "traceability:check": "uv run python scripts/traceability.py check",
    "verify": "uv run python scripts/verify.py",
    "doctor": "python3 scripts/doctor.py",
    "preflight": "python3 scripts/doctor.py --preflight"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@types/node": "catalog:",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "turbo": "2.10.7",
    "typescript": "catalog:",
    "typescript-eslint": "8.65.0"
  }
}
