{
  "name": "japp-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for the local-first job application platform (spec JAPP-MASTER-001). Neutral naming per owner decision OD-003.",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.17.0"
  },
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "test": "turbo run test",
    "test:browser-smoke": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@types/node": "catalog:",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "turbo": "2.10.7",
    "typescript": "catalog:",
    "typescript-eslint": "8.65.0"
  }
}
